[user]
	name = Alex Turner
	email = alex@turntrout.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	autocrlf = input
	safecrlf = true
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
	templateDir = ~/.git_templates
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	type = cat-file -t
	dump = cat-file -p
[diff]
	tool = vscode
[credential]
	helper = cache --timeout=86400
	helper = /usr/local/share/gcm-core/git-credential-manager
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[fetch]
	prune = true
[credential "https://github.com"]
	helper = 
	helper = !/Users/turntrout/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/Users/turntrout/.local/bin/gh auth git-credential
