{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "Bash(fish -c *)",
      "Bash(eval *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "WebFetch(domain:pastebin.com)",
      "WebFetch(domain:transfer.sh)",
      "WebFetch(domain:0x0.st)",
      "WebFetch(domain:gist.github.com)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/review-edit.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/gate-pr-skill.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "agent-sanitizer@agent-sanitizer": true
  },
  "extraKnownMarketplaces": {
    "agent-sanitizer": {
      "source": {
        "source": "github",
        "repo": "AlexanderMattTurner/agent-sanitizer"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "~/.bashrc",
        "~/.zshrc",
        "~/.profile",
        "~/.config/fish/**"
      ],
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "**/.env*"
      ]
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
