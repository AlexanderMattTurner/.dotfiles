<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.turntrout.cache-prune</string>

    <!-- Runs bin/cache-prune.bash weekly through the dotfiles dispatcher.
         bash expands $HOME, so this plain plist holds no user-specific path.
         launchd runs a calendar job that the machine slept through when the
         machine wakes. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.local/bin/dotfiles" cache-prune &gt;&gt;"$HOME/Library/Logs/cache-prune.log" 2&gt;&amp;1</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
